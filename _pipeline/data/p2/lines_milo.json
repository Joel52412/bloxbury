["she", 16.94, 17.14], ["had", 17.14, 17.29], ["a", 17.29, 17.34], ["key", 17.34, 17.82]], "cut_db": [-93, -89]}, {"text": "So who's in my kitchen?", "a": 17.91, "b": 19.66, "words": [["so", 18.1, 18.37], ["who's", 18.37, 18.69], ["in", 18.69, 18.78], ["my", 18.78, 18.91], ["kitchen", 18.91, 19.43]], "cut_db": [-89, -90]}, {"text": "It looked like Mum.", "a": 20.2, "b": 21.4, "words": [["it", 20.27, 20.35], ["looked", 20.35, 20.6], ["like", 20.6, 20.77], ["mum", 20.77, 21.03]], "cut_db": [-88, -91]}, {"text": "Then Mum stopped smiling.", "a": 21.39, "b": 23.3, "words": [["then", 21.45, 21.82], ["mum", 21.95, 22.16], ["stopped", 22.16, 22.54], ["smiling", 22.54, 23.09]], "cut_db": [-91, -90]}, {"text": "Her reflection didn't.", "a": 23.29, "b": 24.82, "words": [["her", 23.37, 23.49], ["reflection", 23.49, 24.08], ["didn't", 24.24, 24.57]], "cut_db": [-90, -90]}, {"text": "I locked my door.", "a": 24.81, "b": 25.85, "words": [["i", 24.88, 24.96], ["locked", 24.96, 25.23], ["my", 25.23, 25.34], ["door", 25.34, 25.66]], "cut_db": [-90, -90]}, {"text": "Then a voice came from inside my closet.", "a": 25.84, "b": 28.13, "words": [["then", 25.91, 26.04], ["a", 26.04, 26.09], ["voice", 26.09, 26.48], ["came", 26.48, 26.7], ["from", 26.7, 26.85], ["inside", 26.85, 27.3], ["my", 27.3, 27.4], ["closet", 27.4, 27.82]], "cut_db": [-90, -89]}, {"text": "Mum?", "a": 28.12, "b": 28.77, "words": [["mum", 28.2, 28.52]], "cut_db": [-89, -90]}, {"text": "Two mums. One door.", "a": 28.76, "b": 30.45, "words": [["two", 28.81, 29.08], ["mums", 29.08, 29.48], ["one", 29.67, 29.98], ["door", 29.98, 30.35]], "cut_db": [-90, -90]}, {"text": "Which one would you open?", "a": 30.44, "b": 31.84, "words": [["which", 30.62, 30.8], ["one", 30.8, 30.96], ["would", 30.96, 31.07], ["you", 31.07, 31.29], ["open", 31.29, 31.61]], "cut_db": [-90, -91]}, {"text": "Comment below... Part Three depends on it.", "a": 31.83, "b": 34.27, "words": [["comment", 31.83, 32.15], ["below", 32.15, 32.48], ["part", 32.