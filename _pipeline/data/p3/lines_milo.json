[{"text": "I haven't said a single word in three hours.", "a": 0.0, "b": 3.05, "words": [["i", 0.15, 0.21], ["haven't", 0.21, 0.6], ["said", 0.6, 0.81], ["a", 0.81, 0.85], ["single", 0.85, 1.37], ["word", 1.37, 1.7], ["in", 1.7, 1.9], ["three", 1.9, 2.21], ["hours", 2.46, 2.96]], "cut_db": [-180, -89]}, {"text": "Because the thing outside my door learns every word it hears.", "a": 3.04, "b": 7.06, "words": [["because", 3.31, 3.65], ["the", 3.65, 3.76], ["thing", 3.76, 4.08], ["outside", 4.08, 4.47], ["my", 4.47, 4.63], ["door", 4.63, 5.03], ["learns", 5.11, 5.38], ["every", 5.53, 5.92], ["word", 5.92, 6.21], ["it", 6.21, 6.33], ["hears", 6.33, 6.88]], "cut_db": [-89, -90]}, {"text": "Last night, it didn't know that word.", "a": 7.05, "b": 9.74, "words": [["last", 7.26, 7.53], ["night", 7.53, 7.92], ["it", 8.15, 8.29], ["didn't", 8.29, 8.64], ["know", 8.64, 8.82], ["that", 8.82, 9.06], ["word", 9.06, 9.44]], "cut_db": [-90, -89]}, {"text": "Then it heard Mum say it.", "a": 9.73, "b": 11.52, "words": [["then", 9.79, 9.96], ["it", 9.96, 10.07], ["heard", 10.07, 10.35], ["mum", 10.35, 10.57], ["say", 10.57, 10.95], ["it", 10.95, 11.11]], "cut_db": [-89, -90]}, {"text": "Mum had three rules.", "a": 11.51, "b": 13.22, "words": [["mum", 11.6, 11.84], ["had", 11.84, 12.06], ["three", 12.06, 12.43], ["rules", 12.43, 12.95]], "cut_db": [-90, -90]}, {"text": "Brush your teeth.", "a": 13.21, "b": 14.14, "words": [["brush", 13.19, 13.42], ["your", 13.42, 13.53], ["teeth", 13.53, 13.81]], "cut_db": [-90, -90]}, {"text": "Lock your door.", "a": 14.13, "b": 15.14, "words": [["lock", 14.14, 14.41], ["your", 14.41, 14.52], ["door", 14.52, 14.9]], "cut_db": [-90, -90]}, {"text": "And never, ever say our secret word out loud.", "a": 15.13, "b": 18.46, "words": [["and", 15.18, 15.28], ["never", 15.28, 15.8], ["ever", 15.97, 16.29], ["say", 16.36, 16.62], ["our", 16.62, 16.73], ["secret", 16.73, 17.13], ["word", 17.13, 17.51], ["out", 17.51, 17.67], ["loud", 17.67, 18.12]], "cut_db": [-90, -89]}, {"text": "It wasn't checking me.", "a": 18.45, "b": 19.89, "words": [["it", 18.55, 18.63], ["wasn't", 18.63, 18.96], ["checking", 18.96, 19.26], ["me", 19.26, 19.42]], "cut_db": [-89, -88]}, {"text": "It was learning.", "a": 19.88, "b": 20.91, "words": [["it", 19.95, 20.06], ["was", 20.06, 20.26], ["learning", 20.26, 20.72]], "cut_db": [-88, -89]}, {"text": "So I didn't say it.", "a": 20.9, "b": 22.36, "words": [["so", 21.19, 21.38], ["i", 21.38, 21.47], ["didn't", 21.47, 21.67], ["say", 21.67, 21.96], ["it", 21.96, 22.11]], "cut_db": [-89, -89]}, {"text": "I wrote it down.", "a": 22.35, "b": 23.25, "words": [["i", 22.39, 22.45], ["wrote", 22.45, 22.66], ["it", 22.66, 22.76], ["down", 22.76, 23.15]], "cut_db": [-89, -89]}, {"text": "I didn't make a sound the whole way.", "a": 23.24, "b": 25.47, "words": [["i", 23.49, 23.61], ["didn't", 23.61, 23.87], ["make", 23.87, 24.02], ["a", 24.02, 24.06], ["sound", 24.06, 24.51], ["the", 24.51, 24.6], ["whole", 24.6, 24.98], ["way", 24.98, 25.35]], "cut_db": [-89, -31]}, {"text": "I never said it out loud.", "a": 25.47, "b": 26.97, "words": [["i", 25.6, 25.8], ["never", 25.81, 26.03], ["said", 26.03, 26.24], ["it", 26.24, 26.32], ["out", 26.32, 26.49], ["loud", 26.49, 26.83]], "cut_db": [-31, -36]}, {"text": "I only wrote it down once.", "a": 26.97, "b": 29.14, "words": [["i", 26.83, 26.89], ["only", 27.37, 27.73], ["wrote", 27.73, 27.91], ["it", 27.91, 28.01], ["down", 28.01, 28.42], ["once", 28.42, 28.9]], "cut_db": [-47, -90]}, {"text": "And I gave it to the closet.", "a": 29.13, "b": 30.93, "words": [["and", 29.14, 29.3], ["i", 29.3, 29.41], ["gave", 29.54, 29.73], ["it", 29.73, 29.84], ["to", 29.84, 29.97], ["the", 29.97, 30.06], ["closet", 30.06, 30.65]], "cut_db": [-90, -89]}, {"text": "Most of you told me to trust the closet.", "a": 30.92, "b": 33.06, "words": [["most", 30.94, 31.23], ["of", 31.23, 31.29], ["you", 31.29, 31.45], ["told", 31.45, 31.69], ["me", 31.69, 31.78], ["to", 31.78, 31.86], ["trust", 31.86, 32.26], ["the", 32.26, 32.33], ["closet", 32.33, 32.83]], "cut_db": [-89, -89]}, {"text": "So did I.", "a": 33.05, "b": 34.2, "words": [["so", 33.12, 33.38], ["did", 33.38, 33.54], ["i", 33.54, 33.94]], "cut_db": [-88, -90]}, {"text": "Rae, it's me.", "a": 34.19, "b": 35.64, "words": [["rae", 34.2, 34.52], ["it's", 34.84, 35.05], ["me", 35.05, 35.24]], "cut_db": [-90, -90]}, {"text": "Don't let him in.", "a": 35.63, "b": 36.68, "words": [["don't", 35.62, 35.81], ["let", 35.81, 35.97], ["him", 35.97, 36.08], ["in", 36.08, 36.39]], "cut_db": [-90, -91]}, {"text": "One of us is on the porch.", "a": 36.67, "b": 38.06, "words": [["one", 36.73, 36.85], ["of", 36.85, 36.93], ["us", 36.93, 37.09], ["is", 37.09, 37.2], ["on", 37.2, 37.29], ["the", 37.29, 37.36], ["porch", 37.36, 37.85]], "cut_db": [-91, -90]}, {"text": "One of us is on the phone.", "a": 38.05, "b": 39.49, "words": [["one", 38.14, 38.28], ["of", 38.28, 38.37], ["us", 38.37, 38.61], ["is", 38.61, 38.75], ["on", 38.75, 38.83], ["the", 38.83, 38.9], ["phone", 38.9, 39.41]], "cut_db": [-89, -90]}, {"text": "Which Milo would you let in?", "a": 0.12, "b": 1.92, "words": [["which", 0.21, 0.47], ["milo", 0.47, 0.85], ["would", 0.85, 0.99], ["you", 0.99, 1.2], ["let", 1.2, 1.44], ["in", 1.44, 1.7]], "cut_db": null, "file": "milo_p3_fix.mp3"}]