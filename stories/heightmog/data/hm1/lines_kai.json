[{"text": "In this town, the taller you are, the more power you get.", "a": 0.0, "b": 3.27, "words": [["in", 0.08, 0.2], ["this", 0.2, 0.36], ["town", 0.36, 0.89], ["the", 1.0, 1.07], ["taller", 1.09, 1.3], ["you", 1.3, 1.5], ["are", 1.5, 1.76], ["the", 2.03, 2.08], ["more", 2.08, 2.25], ["power", 2.3, 2.48], ["you", 2.48, 2.72], ["get", 2.72, 2.98]], "cut_db": [-180, -94]}, {"text": "Six foot? Nice car.", "a": 3.26, "b": 4.67, "words": [["six", 3.38, 3.48], ["foot", 3.48, 3.68], ["nice", 4.04, 4.2], ["car", 4.2, 4.48]], "cut_db": [-94, -102]}, {"text": "Five foot? Bus.", "a": 4.66, "b": 6.12, "words": [["five", 4.92, 5.08], ["foot", 5.08, 5.28], ["bus", 5.72, 5.82]], "cut_db": [-102, -95]}, {"text": "Me? Four foot one. I walk behind the bus.", "a": 6.11, "b": 8.99, "words": [["me", 6.27, 6.48], ["four", 6.88, 7.06], ["foot", 7.06, 7.22], ["one", 7.22, 7.52], ["i", 7.82, 7.92], ["walk", 7.92, 8.06], ["behind", 8.13, 8.44], ["the", 8.44, 8.6], ["bus", 8.6, 8.84]], "cut_db": [-95, -108]}, {"text": "And our mayor? Nine feet tall. Nobody has ever told him no.", "a": 8.98, "b": 12.86, "words": [["and", 9.19, 9.3], ["our", 9.3, 9.44], ["mayor", 9.44, 9.66], ["nine", 10.18, 10.34], ["feet", 10.34, 10.62], ["tall", 10.68, 10.94], ["nobody", 11.26, 11.42], ["has", 11.42, 11.72], ["ever", 11.83, 12.04], ["told", 12.04, 12.26], ["him", 12.26, 12.44], ["no", 12.44, 12.68]], "cut_db": [-108, -180]}, {"text": "But something about him was off.", "a": 12.85, "b": 14.84, "words": [["but", 12.99, 13.1], ["something", 13.1, 13.36], ["about", 13.62, 13.76], ["him", 13.76, 13.96], ["was", 13.96, 14.12], ["off", 14.26, 14.54]], "cut_db": [-180, -91]}, {"text": "He never sits.", "a": 14.83, "b": 16.22, "words": [["he", 14.98, 15.1], ["never", 15.1, 15.42], ["sits", 15.42, 15.84]], "cut_db": [-91, -180]}, {"text": "He never bends down.", "a": 16.21, "b": 17.88, "words": [["he", 16.39, 16.54], ["never", 16.54, 16.92], ["bends", 16.92, 17.18], ["down", 17.18, 17.55]], "cut_db": [-180, -180]}, {"text": "Once, a dog sniffed him... and the coat sneezed.", "a": 17.87, "b": 20.89, "words": [["once", 18.08, 18.3], ["a", 18.58, 18.74], ["dog", 18.74, 18.92], ["sniffed", 18.92, 19.36], ["him", 19.36, 19.55], ["and", 19.77, 19.86], ["the", 19.86, 19.93], ["coat", 19.96, 20.14], ["sneezed", 20.14, 20.82]], "cut_db": [-180, -90]}, {"text": "And his coat... has six shoes.", "a": 20.88, "b": 23.51, "words": [["and", 21.08, 21.22], ["his", 21.22, 21.38], ["coat", 21.46, 21.92], ["has", 22.3, 22.33], ["six", 22.33, 22.64], ["shoes", 22.67, 23.16]], "cut_db": [-90, -104]}, {"text": "Then I heard him backstage.", "a": 23.5, "b": 25.23, "words": [["then", 23.73, 23.84], ["i", 23.84, 24.0], ["heard", 24.0, 24.14], ["him", 24.14, 24.35], ["backstage", 24.35, 24.78]], "cut_db": [-104, -96]}, {"text": "So at his big speech... I made my move.", "a": 25.22, "b": 27.69, "words": [["so", 25.34, 25.48], ["at", 25.48, 25.62], ["his", 25.62, 25.76], ["big", 25.8, 25.92], ["speech", 26.1, 26.3], ["i", 26.7, 26.8], ["made", 26.8, 26.98], ["my", 26.98, 27.16], ["move", 27.16, 27.44]], "cut_db": [-96, -112]}, {"text": "One tickle.", "a": 27.68, "b": 28.54, "words": [["one", 27.86, 28.02], ["tickle", 28.02, 28.44]], "cut_db": [-112, -98]}, {"text": "They were shorter than me.", "a": 28.53, "b": 29.89, "words": [["they", 28.79, 28.92], ["were", 28.92, 29.08], ["shorter", 29.08, 29.32], ["than", 29.32, 29.56], ["me", 29.56, 29.76]], "cut_db": [-98, -93]}, {"text": "I could've exposed them...", "a": 29.88, "b": 31.26, "words": [["i", 30.1, 30.19], ["could've", 30.21, 30.44], ["exposed", 30.69, 30.8], ["them", 30.8, 31.18]], "cut_db": [-93, -180]}, {"text": "Taxes... cancelled.", "a": 31.25, "b": 32.75, "words": [["taxes", 31.56, 31.72], ["cancelled", 32.18, 32.5]], "cut_db": [-180, -91]}, {"text": "Turns out the top spot was open.", "a": 32.74, "b": 34.52, "words": [["turns", 32.97, 33.06], ["out", 33.06, 33.32], ["the", 33.32, 33.48], ["top", 33.48, 33.64], ["spot", 33.78, 33.9], ["was", 33.9, 34.04], ["open", 34.04, 34.32]], "cut_db": [-91, -97]}, {"text": "Every Tuesday, we swap who's on the bottom.", "a": 34.51, "b": 36.46, "words": [["every", 34.61, 34.79], ["tuesday", 34.79, 35.1], ["we", 35.36, 35.44], ["swap", 35.44, 35.65], ["who's", 35.65, 35.86], ["on", 35.86, 35.96], ["the", 35.96, 36.06], ["bottom", 36.06, 36.29]], "cut_db": [-97, -99]}, {"text": "Would you expose them... or join them?", "a": 36.45, "b": 38.57, "words": [["would", 36.68, 36.76], ["you", 36.76, 36.9], ["expose", 37.14, 37.26], ["them", 37.26, 37.52], ["or", 37.8, 37.9], ["join", 37.9, 38.11], ["them", 38.11, 38.35]], "cut_db": [-99, -92]}, {"text": "Because in this town...", "a": 38.56, "b": 39.75, "words": [["because", 38.67, 38.86], ["in", 38.86, 39.02], ["this", 39.02, 39.18], ["town", 39.18, 39.61]], "cut_db": [-92, -180]}]