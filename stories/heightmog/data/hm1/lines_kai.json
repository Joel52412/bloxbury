[{"text": "In this town, the taller you are, the more power you get.", "a": 0.0, "b": 3.24, "words": [["in", 0.08, 0.2], ["this", 0.2, 0.36], ["town", 0.36, 0.41], ["the", 1.04, 1.13], ["taller", 1.15, 1.36], ["you", 1.36, 1.58], ["are", 1.58, 1.86], ["the", 2.13, 2.18], ["more", 2.18, 2.36], ["power", 2.42, 2.6], ["you", 2.6, 2.86], ["get", 2.86, 2.91]], "cut_db": [-180, -91]}, {"text": "Six foot? Nice car.", "a": 3.23, "b": 5.03, "words": [["six", 3.56, 3.66], ["foot", 3.66, 3.86], ["nice", 4.25, 4.42], ["car", 4.42, 4.72]], "cut_db": [-91, -90]}, {"text": "Five foot? Bus.", "a": 5.02, "b": 6.55, "words": [["five", 5.18, 5.34], ["foot", 5.34, 5.56], ["bus", 6.02, 6.12]], "cut_db": [-90, -90]}, {"text": "Me? Four foot one. I walk behind the bus.", "a": 6.54, "b": 9.6, "words": [["me", 6.62, 6.82], ["four", 7.24, 7.42], ["foot", 7.42, 7.58], ["one", 7.58, 7.9], ["i", 8.23, 8.32], ["walk", 8.32, 8.46], ["behind", 8.55, 8.86], ["the", 8.86, 9.03], ["bus", 9.03, 9.27]], "cut_db": [-90, -90]}, {"text": "And our mayor? Nine feet tall. Nobody has ever told him no.", "a": 9.59, "b": 13.58, "words": [["and", 9.68, 9.77], ["our", 9.77, 9.92], ["mayor", 9.92, 10.16], ["nine", 10.7, 10.86], ["feet", 10.86, 11.14], ["tall", 11.22, 11.5], ["nobody", 11.84, 12.02], ["has", 12.02, 12.32], ["ever", 12.43, 12.66], ["told", 12.66, 12.9], ["him", 12.9, 13.08], ["no", 13.08, 13.32]], "cut_db": [-90, -90]}, {"text": "But something about him was off.", "a": 13.57, "b": 15.67, "words": [["but", 13.66, 13.77], ["something", 13.77, 14.06], ["about", 14.32, 14.46], ["him", 14.46, 14.66], ["was", 14.66, 14.84], ["off", 14.99, 15.28]], "cut_db": [-90, -90]}, {"text": "He never sits.", "a": 15.66, "b": 17.16, "words": [["he", 15.75, 15.88], ["never", 15.88, 16.22], ["sits", 16.22, 16.66]], "cut_db": [-90, -90]}, {"text": "He never bends down.", "a": 17.16, "b": 18.94, "words": [["he", 17.24, 17.39], ["never", 17.39, 17.78], ["bends", 17.78, 18.05], ["down", 18.22, 18.48]], "cut_db": [-90, -90]}, {"text": "Once, a dog sniffed him... and the coat sneezed.", "a": 18.93, "b": 22.14, "words": [["once", 19.0, 19.23], ["a", 19.53, 19.69], ["dog", 19.7, 19.89], ["sniffed", 19.89, 20.34], ["him", 20.74, 20.77], ["and", 20.77, 20.86], ["the", 20.86, 20.95], ["coat", 20.98, 21.18], ["sneezed", 21.18, 21.89]], "cut_db": [-90, -90]}, {"text": "And his coat... has six shoes.", "a": 22.13, "b": 24.66, "words": [["and", 22.16, 22.3], ["his", 22.3, 22.48], ["coat", 22.56, 23.06], ["has", 23.44, 23.47], ["six", 23.47, 23.81], ["shoes", 23.83, 24.34]], "cut_db": [-90, -88]}, {"text": "Then I heard him backstage.", "a": 24.85, "b": 26.42, "words": [["then", 24.95, 25.06], ["i", 25.06, 25.24], ["heard", 25.24, 25.4], ["him", 25.4, 25.58], ["backstage", 25.59, 26.04]], "cut_db": [-90, -95]}, {"text": "So at his big speech... I made my move.", "a": 26.41, "b": 29.18, "words": [["so", 26.63, 26.8], ["at", 26.8, 26.94], ["his", 26.94, 27.08], ["big", 27.13, 27.26], ["speech", 27.44, 27.66], ["i", 28.07, 28.18], ["made", 28.18, 28.36], ["my", 28.36, 28.56], ["move", 28.56, 28.86]], "cut_db": [-95, -90]}, {"text": "One tickle.", "a": 29.17, "b": 30.18, "words": [["one", 29.28, 29.46], ["tickle", 29.46, 29.88]], "cut_db": [-90, -90]}, {"text": "They were shorter than me.", "a": 30.17, "b": 31.55, "words": [["they", 30.27, 30.36], ["were", 30.36, 30.52], ["shorter", 30.52, 30.82], ["than", 30.82, 31.08], ["me", 31.08, 31.33]], "cut_db": [-90, -90]}, {"text": "I could've exposed them...", "a": 31.54, "b": 32.81, "words": [["i", 31.64, 31.74], ["could've", 31.76, 32.0], ["exposed", 32.27, 32.38], ["them", 32.38, 32.74]], "cut_db": [-90, -91]}, {"text": "Taxes... cancelled.", "a": 32.8, "b": 34.55, "words": [["taxes", 33.02, 33.34], ["cancelled", 33.74, 34.18]], "cut_db": [-80, -89]}, {"text": "Turns out the top spot was open.", "a": 34.54, "b": 36.35, "words": [["turns", 34.58, 34.74], ["out", 34.74, 35.02], ["the", 35.1, 35.19], ["top", 35.2, 35.36], ["spot", 35.51, 35.61], ["was", 35.61, 35.79], ["open", 35.99, 36.1]], "cut_db": [-89, -90]}, {"text": "Every Tuesday, we swap who's on the bottom.", "a": 36.34, "b": 38.48, "words": [["every", 36.38, 36.58], ["tuesday", 36.58, 36.63], ["we", 36.96, 37.24], ["swap", 37.24, 37.5], ["who's", 37.5, 37.55], ["on", 37.7, 37.79], ["the", 37.79, 37.9], ["bottom", 37.9, 38.15]], "cut_db": [-90, -90]}, {"text": "Would you expose them... or join them?", "a": 38.47, "b": 40.61, "words": [["would", 38.54, 38.64], ["you", 38.64, 38.78], ["expose", 39.04, 39.15], ["them", 39.15, 39.46], ["or", 39.74, 39.84], ["join", 39.84, 40.1], ["them", 40.1, 40.32]], "cut_db": [-90, -90]}, {"text": "Because in this town...", "a": 40.6, "b": 41.79, "words": [["because", 40.65, 40.82], ["in", 40.82, 41.0], ["this", 41.0, 41.18], ["town", 41.18, 41.48]], "cut_db": [-90, -180]}]