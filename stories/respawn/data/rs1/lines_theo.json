[{"text": "That's the fourth time I've died today.", "a": 0.0, "b": 2.57, "words": [["that's", 0.1, 0.32], ["the", 0.32, 0.5], ["fourth", 0.5, 0.84], ["time", 0.84, 1.2], ["i've", 1.2, 1.42], ["died", 1.44, 1.62], ["today", 1.62, 2.12]], "cut_db": [-180, -90]}, {"text": "Same apple. Same words. Every time.", "a": 2.56, "b": 5.89, "words": [["same", 2.86, 2.94], ["apple", 2.94, 3.3], ["same", 3.88, 4.08], ["words", 4.08, 4.46], ["every", 5.09, 5.34], ["time", 5.34, 5.39]], "cut_db": [-90, -84]}, {"text": "Three hours ago, I was in bed playing Roblox.", "a": 6.16, "b": 9.29, "words": [["three", 6.31, 6.54], ["hours", 6.54, 6.74], ["ago", 6.74, 7.1], ["i", 7.46, 7.51], ["was", 7.62, 7.7], ["in", 7.7, 7.86], ["bed", 7.86, 8.02], ["playing", 8.12, 8.32], ["roblox", 8.32, 8.88]], "cut_db": [-90, -89]}, {"text": "Server called Lanternfall. One player. Three AM.", "a": 9.28, "b": 13.01, "words": [["server", 9.58, 9.66], ["called", 9.66, 9.94], ["lanternfall", 9.94, 10.62], ["one", 11.17, 11.36], ["player", 11.36, 11.68], ["three", 12.15, 12.38], ["am", 12.38, 12.56]], "cut_db": [-89, -86]}, {"text": "I clicked join.", "a": 13.13, "b": 14.3, "words": [["i", 13.25, 13.35], ["clicked", 13.37, 13.54], ["join", 13.63, 13.86]], "cut_db": [-90, -87]}, {"text": "And the game... clicked back.", "a": 14.43, "b": 16.37, "words": [["and", 14.49, 14.62], ["the", 14.62, 14.72], ["game", 14.74, 15.26], ["clicked", 15.64, 15.67], ["back", 15.8, 16.0]], "cut_db": [-90, -90]}, {"text": "The first time round, I met her.", "a": 16.53, "b": 18.64, "words": [["the", 16.57, 16.68], ["first", 16.68, 16.86], ["time", 16.86, 17.12], ["round", 17.12, 17.39], ["i", 17.72, 17.82], ["met", 17.82, 17.96], ["her", 17.96, 18.22]], "cut_db": [-90, -90]}, {"text": "Wren. Lamplighter's apprentice. Someone had stolen the Sun Lantern.", "a": 18.63, "b": 22.52, "words": [["wren", 18.88, 18.91], ["lamplighter's", 19.38, 19.93], ["apprentice", 19.93, 20.07], ["someone", 20.74, 20.92], ["had", 20.92, 21.12], ["stolen", 21.12, 21.42], ["the", 21.42, 21.68], ["sun", 21.68, 21.86], ["lantern", 21.86, 22.18]], "cut_db": [-90, -90]}, {"text": "The dark? Like... night?", "a": 22.51, "b": 24.9, "words": [["the", 22.7, 23.08], ["dark", 23.08, 23.42], ["like", 24.2, 24.48], ["night", 24.48, 24.51]], "cut_db": [-90, -90]}, {"text": "We followed the thief till sunset.", "a": 25.03, "b": 27.02, "words": [["we", 25.09, 25.18], ["followed", 25.18, 25.44], ["the", 25.44, 25.66], ["thief", 25.66, 25.9], ["till", 25.9, 25.95], ["sunset", 26.1, 26.52]], "cut_db": [-90, -90]}, {"text": "Then the last bell rang...", "a": 27.01, "b": 28.73, "words": [["then", 27.13, 27.28], ["the", 27.36, 27.42], ["last", 27.42, 27.7], ["bell", 27.85, 28.02], ["rang", 28.02, 28.44]], "cut_db": [-90, -89]}, {"text": "So I tried again.", "a": 28.72, "b": 30.05, "words": [["so", 29.04, 29.07], ["i", 29.07, 29.16], ["tried", 29.19, 29.4], ["again", 29.4, 29.74]], "cut_db": [-89, -87]}, {"text": "Second time, I kept her off the streets. The stairs gave way.", "a": 30.04, "b": 33.38, "words": [["second", 30.22, 30.38], ["time", 30.38, 30.68], ["i", 30.86, 30.98], ["kept", 30.98, 31.12], ["her", 31.12, 31.26], ["off", 31.26, 31.34], ["the", 31.34, 31.39], ["streets", 31.52, 31.76], ["the", 32.23, 32.32], ["stairs", 32.32, 32.58], ["gave", 32.58, 32.79], ["way", 32.79, 33.1]], "cut_db": [-87, -89]}, {"text": "Third time, I hid us in a cellar. The lamp went out.", "a": 33.37, "b": 36.64, "words": [["third", 33.46, 33.65], ["time", 33.65, 33.96], ["i", 34.22, 34.34], ["hid", 34.34, 34.47], ["us", 34.47, 34.64], ["in", 34.64, 34.72], ["a", 34.72, 34.82], ["cellar", 34.82, 35.06], ["the", 35.5, 35.6], ["lamp", 35.6, 35.79], ["went", 35.79, 36.02], ["out", 36.02, 36.32]], "cut_db": [-89, -90]}, {"text": "And every time I came back...", "a": 36.63, "b": 38.29, "words": [["and", 36.72, 36.84], ["every", 36.93, 37.2], ["time", 37.2, 37.42], ["i", 37.42, 37.61], ["came", 37.61, 37.79], ["back", 37.79, 38.11]], "cut_db": [-90, -92]}, {"text": "She didn't remember. Nobody did. Just me.", "a": 38.28, "b": 41.58, "words": [["she", 38.61, 38.76], ["didn't", 38.76, 38.97], ["remember", 38.97, 39.34], ["nobody", 39.92, 40.1], ["did", 40.1, 40.42], ["just", 40.83, 40.98], ["me", 40.98, 41.24]], "cut_db": [-92, -87]}, {"text": "So the fourth time, I stopped playing nice.", "a": 41.57, "b": 44.4, "words": [["so", 41.7, 41.78], ["the", 41.78, 41.94], ["fourth", 41.94, 42.16], ["time", 42.16, 42.48], ["i", 42.87, 42.96], ["stopped", 42.96, 43.29], ["playing", 43.3, 43.66], ["nice", 43.66, 43.98]], "cut_db": [-87, -89]}, {"text": "Wren. Listen. I've died three times today. I keep coming back, and you keep\u2014", "a": 44.39, "b": 49.36, "words": [["wren", 44.6, 44.63], ["listen", 44.96, 45.16], ["i've", 45.64, 45.87], ["died", 45.88, 46.04], ["three", 46.04, 46.42], ["times", 46.42, 46.8], ["today", 46.8, 47.08], ["i", 47.42, 47.61], ["keep", 47.63, 47.82], ["coming", 47.82, 47.87], ["back", 48.08, 48.36], ["and", 48.36, 48.41], ["you", 48.58, 48.82], ["keep", 49.22, 49.27]], "cut_db": [-89, -90]}, {"text": "Everything stopped. Except me.", "a": 49.35, "b": 51.61, "words": [["everything", 49.42, 49.7], ["stopped", 49.7, 50.1], ["except", 50.66, 50.92], ["me", 50.92, 51.2]], "cut_db": [-90, -90]}, {"text": "I died before the sentence finished.", "a": 51.6, "b": 53.77, "words": [["i", 51.71, 51.82], ["died", 51.88, 52.06], ["before", 52.06, 52.4], ["the", 52.4, 52.56], ["sentence", 52.56, 52.84], ["finished", 52.84, 53.28]], "cut_db": [-90, -90]}, {"text": "But that's not the part that scared me.", "a": 53.76, "b": 55.96, "words": [["but", 53.82, 53.93], ["that's", 53.96, 54.2], ["not", 54.2, 54.4], ["the", 54.48, 54.57], ["part", 54.58, 54.78], ["that", 54.83, 54.96], ["scared", 54.96, 55.2], ["me", 55.2, 55.52]], "cut_db": [-90, -90]}, {"text": "This time... the apple didn't stop at my feet.", "a": 55.95, "b": 58.97, "words": [["this", 55.92, 55.97], ["time", 56.16, 56.48], ["the", 56.92, 57.02], ["apple", 57.02, 57.07], ["didn't", 57.48, 57.74], ["stop", 57.74, 57.96], ["at", 57.96, 58.01], ["my", 58.1, 58.26], ["feet", 58.26, 58.58]], "cut_db": [-90, -90]}, {"text": "Nobody here knows my name.", "a": 58.96, "b": 61.04, "words": [["nobody", 59.1, 59.32], ["here", 59.32, 59.74], ["knows", 59.74, 59.94], ["my", 59.94, 60.2], ["name", 60.2, 60.59]], "cut_db": [-90, -90]}, {"text": "Would you have told her... or kept quiet and kept dying?", "a": 61.03, "b": 64.04, "words": [["would", 61.08, 61.18], ["you", 61.18, 61.34], ["have", 61.34, 61.44], ["told", 61.44, 61.62], ["her", 61.62, 61.88], ["or", 62.22, 62.31], ["kept", 62.33, 62.5], ["quiet", 62.59, 62.86], ["and", 62.86, 63.1], ["kept", 63.1, 63.29], ["dying", 63.37, 63.68]], "cut_db": [-90, -90]}, {"text": "And that... was only the fourth time I died today.", "a": 64.03, "b": 67.0, "words": [["and", 64.13, 64.26], ["that", 64.26, 64.52], ["was", 64.92, 64.97], ["only", 65.06, 65.28], ["the", 65.28, 65.45], ["fourth", 65.45, 65.72], ["time", 65.72, 66.04], ["i", 66.04, 66.22], ["died", 66.26, 66.4], ["today", 66.49, 66.73]], "cut_db": [-90, -180]}]